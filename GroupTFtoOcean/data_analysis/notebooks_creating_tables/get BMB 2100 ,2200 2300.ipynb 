    "# avg and abs 2100\n",
    "models=[]\n",
    "paths =[]\n",
    "exps =[]\n",
    "for exp in expnames:\n",
    "    lst = glob.glob(pth_helene+f'{exp}/shelfmelt/*.nc')\n",
    "    lst.sort()\n",
    "\n",
    "    for name in lst:\n",
    "        model = get_model(name,exp)\n",
    "        if model in removeFileID:\n",
    "            continue\n",
    "        else:\n",
    "            models.append(model)\n",
    "            paths.append(name)\n",
    "            exps.append(exp)\n",
    "df = pd.DataFrame({ 'Experiment': exps,'Model': models, 'Path': paths}) \n",
    "for i in range(1,19):\n",
    "    df['sector_'+str(i)]=0\n",
    "for i in range(1,4):\n",
    "    df['region_'+str(i)]=0\n",
    "for key in dic_area_of_interest.keys():\n",
    "    df[key]=0\n",
    "df['AIS']=0\n",
    "df2 = df.copy()\n",
    "for i in range (df.shape[0]):\n",
    "    pth_way = df.iloc[i].Path\n",
    "    #get shelf area\n",
    "    pth_area = f'{pth_helene}/{df.iloc[i].Experiment}/iareafl/computed_iareafl_AIS_{df.iloc[i].Model}_{df.iloc[i].Experiment}.nc'\n",
    "    \n",
    "    # Melting\n",
    "    d = xr.open_dataset(pth_way,decode_times=False )\n",
    "    # Area\n",
    "    d2 = xr.open_dataset(pth_area,decode_times=False )\n",
    "    #\n",
    "    ind = np.where((d.time.values >=2270) & (d.time.values <= 2300))\n",
    "    \n",
    "    \n",
    "    \n",
    "    tmin = np.min([d.time.size,d2.time.size])\n",
    "    #melting per area\n",
    "    y =-1*d.shelfmelt.values[:tmin]* 365.25 * 24 * 3600/900/d2.iareafl.values[:tmin] #GT/m^3 yr\n",
    "    yBMB =-1*d.shelfmelt.values[:tmin]* 365.25 * 24 * 3600/900\n",
    "    \n",
    "   \n",
    "    yais =y[ind].mean()\n",
    "    yaisBMB =yBMB[ind].mean()\n",
    "    \n",
    "    \n",
    "    df['AIS'].iloc[i]=  yais\n",
    "    df2['AIS'].iloc[i]=  yaisBMB\n",
    "    \n",
    "\n",
    "    for j in range(1,19):\n",
    "        y =-1*d['shelfmelt_sector_'+str(j)].values[:tmin]* 365.25 * 24 * 3600/900/d2['iareafl_sector_'+str(j)].values[:tmin]  #GT/m^3 yr\n",
    "        yBMB=-1*d['shelfmelt_sector_'+str(j)].values[:tmin]* 365.25 * 24 * 3600/900\n",
    "        \n",
    "        mnan = np.isnan(y)\n",
    "        \n",
    "        \n",
    "       \n",
    "        df['sector_'+str(j)].iloc[i] = y[ind].mean()\n",
    "        df2['sector_'+str(j)].iloc[i] = yBMB[ind].mean()\n",
    "    for j in range(1,4):\n",
    "        y =-1*d['shelfmelt_region_'+str(j)].values[:tmin]* 365.25 * 24 * 3600/900/d2['iareafl_region_'+str(j)].values[:tmin]  #GT/m^3 yr\n",
    "        yBMB=-1*d['shelfmelt_region_'+str(j)].values[:tmin]* 365.25 * 24 * 3600/900\n",
    "        \n",
    "        mnan = np.isnan(y)\n",
    "        \n",
    "        \n",
    "       \n",
    "        df['region_'+str(j)].iloc[i] = y[ind].mean()\n",
    "        df2['region_'+str(j)].iloc[i] = yBMB[ind].mean()\n",
    "        \n",
    "    for key in dic_area_of_interest.keys():\n",
    "        sectors = dic_area_of_interest[key].copy()\n",
    "        ys = np.zeros((len(sectors),tmin))\n",
    "        ysa = np.zeros((len(sectors),tmin))\n",
    "        \n",
    "        areas = np.zeros((len(sectors),tmin))\n",
    "    \n",
    "        for j,sector in enumerate(sectors):\n",
    "            ys[j,:] = -1*d[f'shelfmelt{sector}'].values[:tmin].copy()* 365.25 * 24 * 3600/900\n",
    "            areas[j,:] = d2[f'iareafl{sector}'].values[:tmin].copy()\n",
    "            ysa[j,:]=ys[j,:]*areas[j,:]\n",
    "        yBMB =  np.nansum(ys,axis = 0)\n",
    "        y =  np.nansum(ys,axis = 0)/np.nansum(areas,axis= 0)\n",
    "        df[key].iloc[i] = y[ind].mean()\n",
    "        df2[key].iloc[i] = yBMB[ind].mean()\n",
    "        \n",
    "        \n",
    "#         if (j==1 and i ==4):\n",
    "#             print(d2['iareafl_sector_'+str(j)].values[:tmin])\n",
    "#             break\n",
    "df.to_csv('tables/averegeshelfmelt_2300.csv', index=False)\n",
    "df2.to_csv('tables/totalshelfmelt_2300.csv', index=False)"
   ]
